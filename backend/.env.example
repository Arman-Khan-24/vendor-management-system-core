NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orderledger

# Set your own secret. Generate 32 random bytes (64 hex characters) with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Production refuses missing, short, whitespace-containing, or placeholder secrets.
# Keep this stable: rotating it invalidates logins and requires re-entering provider keys.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Edit provider/model/endpoint/key in the owner's Settings > Connections.
# Save Meta IDs/tokens in Settings > Connections > WhatsApp ordering.
# Incoming orders remain disabled until that business explicitly enables WhatsApp.
# The API process handles the durable PostgreSQL queue; Redis is not required.
WHATSAPP_WORKER_ENABLED=true

# Optional global AI defaults, used only when a business has no saved provider row.
# Prefer business-specific settings. Use current model IDs from your provider console.
AI_PRIMARY_PROVIDER=gemini
AI_PRIMARY_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
AI_FALLBACK_PROVIDER=groq
AI_FALLBACK_MODEL=llama-3.3-70b-versatile
# For Groq photo fallback, set an image-capable model ID before testing photos.
AI_FALLBACK_VISION_MODEL=
GROQ_API_KEY=

# URL defaults; the browser API connection is configured
# separately through VITE_API_URL or the sign-in/Settings connection screen.
PUBLIC_APP_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000
