{
  "name": "orderledger-backend",
  "version": "1.0.0",
  "description": "OrderLedger B2B Multi-Tenant Backend API",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "dev:isolated": "tsx scripts/dev-isolated.ts",
    "test": "tsx --test src/tests/*.test.ts",
    "test:ts": "tsx --test src/tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.10",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.16.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.12",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "pdfkit": "^0.20.2",
    "pg": "^8.18.0",
    "typescript": "^5.8.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "embedded-postgres": "^18.4.0-beta.17",
    "tsx": "^4.19.3"
  }
}
